# Puerto web
PORT=3000

# Modo de correo:
#   preview -> no envía nada, guarda el .eml en data/outbox (por defecto)
#   test    -> envía SOLO a TEST_RECIPIENT
#   live    -> envía a DINACIA_EMAIL (envío real)
MAIL_MODE=preview
DINACIA_EMAIL=plandevuelo@dinacia.gub.uy
TEST_RECIPIENT=

# Envío por Brevo (recomendado en Railway, que bloquea SMTP en el plan Hobby).
# Si está cargada, se usa Brevo y se ignoran las variables SMTP.
BREVO_API_KEY=

# SMTP de tu cuenta de correo (ej. Gmail con contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=plandevuelouruguay@gmail.com
# Contraseña de aplicación de Google (16 letras), nunca la contraseña normal de la cuenta
SMTP_PASS=
MAIL_FROM="Plan de Vuelo Uruguay <plandevuelouruguay@gmail.com>"

# Dirección pública de la app (para los enlaces de recuperar contraseña)
APP_URL=https://planesdevuelo.example.com
# Ruta de la base de datos; en el servidor tiene que estar en un disco persistente
DB_PATH=/data/planes.db
NODE_ENV=production
